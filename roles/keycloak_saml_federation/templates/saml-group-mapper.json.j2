{
  "name": "{{ item.group_mapper_name | default('groups') }}",
  "protocol": "saml",
  "protocolMapper": "saml-group-membership-mapper",
  "config": {
    "attribute.name":       "{{ item.group_attribute_name | default('groups') }}",
    "attribute.nameformat": "Basic",
